# Salin file ini menjadi ".env", lalu isi nilainya.
# Jangan pernah commit file .env atau membagikan Server Key.

# --- Server lokal ---
PORT=3000
HOST=127.0.0.1

# --- Midtrans Sandbox ---
# Ambil dari dashboard Midtrans: Settings > Access Keys
# Biarkan kosong untuk menjalankan mode DEMO (tanpa pembayaran sungguhan).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# URL publik website (opsional, dipakai untuk redirect "finish" Snap).
# Contoh saat memakai ngrok: https://abcd-1234.ngrok-free.app
PUBLIC_BASE_URL=
